{
  "manifest_version": 3,
  "name": "GTM QA Checker",
  "version": "0.4.0",
  "description": "QA linter, version diff, Preview checks and Markdown report generator for Google Tag Manager.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://tagmanager.google.com/*",
    "https://tagassistant.google.com/*",
    "https://api.openai.com/*",
    "https://api.anthropic.com/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "GTM QA Checker",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://tagmanager.google.com/*"
      ],
      "js": [
        "injected.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://tagmanager.google.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://tagassistant.google.com/*"
      ],
      "js": [
        "preview.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "fonts/*.woff2"
      ],
      "matches": [
        "https://tagmanager.google.com/*",
        "https://tagassistant.google.com/*"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
